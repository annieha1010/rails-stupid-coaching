<h1>Stupid Coaching</h1>
<div class="d-flex flex-row justify-content-end mb-4;">
  <div class="p-3 ms-3" style="border-radius: 15px; background-color: rgba(57, 192, 237,.2);">
    <h5><%= params[:question] %></h5>
    <p class="small mb-0">-You</p>
  </div>
</div>

<div class="d-flex flex-row justify-content-start mb-4">
  <div class="p-3 me-3" style="border-radius: 15px; background-color: #fffed9;">
    <h5><%= @response %></h5>
    <p class="small mb-0">-Your couch</p>
  </div>
</div>

<div class="d-grid gap-2 col-2 mx-auto">
  <%= link_to 'Ask a new question', ask_path, :class=>"btn btn-primary" %>
</div>
